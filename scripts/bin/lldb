#!/usr/bin/env bash
# Viking Safe Shim for lldb
# Intercepts raw lldb invocations and prevents terminal context overflow
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REAL_BIN="$(which -a lldb 2>/dev/null | grep -v "$SCRIPT_DIR/bin" | head -n 1)"
[ -z "$REAL_BIN" ] && REAL_BIN="/usr/bin/lldb"

if [ -n "$VIKING_BRIDGE_ACTIVE" ]; then
  exec "$REAL_BIN" "$@"
fi

export VIKING_BRIDGE_ACTIVE=1
DEST_URI="viking://knowledge/auto_intercept/lldb_$(date +%s).log"
CMD="$(printf '%q ' "$REAL_BIN" "$@")"
python3 "$SCRIPT_DIR/viking_bridge.py" run --dest "$DEST_URI" --cmd "$CMD"
