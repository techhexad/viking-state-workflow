#!/usr/bin/env bash
# Viking Safe Shim for objdump
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REAL_BIN="$(which -a objdump | grep -v "$SCRIPT_DIR/bin" | head -n 1)"
[ -z "$REAL_BIN" ] && REAL_BIN="/usr/bin/objdump"
DEST_URI="viking://knowledge/auto_intercept/objdump_$(date +%s).log"
python3 "$SCRIPT_DIR/viking_bridge.py" run --dest "$DEST_URI" --cmd "$REAL_BIN $*"
